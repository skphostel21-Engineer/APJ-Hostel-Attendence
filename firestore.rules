rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.token.admin == true
        && request.auth.token.email != null
        && request.auth.token.email.lower() == 'skphostel21@gmail.com';
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /students/{uid} {
      allow read: if isAdmin() || (signedIn() && (request.auth.uid == uid || resource.data.auth_uid == request.auth.uid));
      allow create, delete: if isAdmin();
      allow update: if isAdmin();
    }

    match /attendance_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow write: if false;
    }

    match /pass_requests/{passId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.student_uid == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /email_recipients/{recipientId} {
      allow read, write: if isAdmin();
    }

    match /daily_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /system_settings/{settingId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

